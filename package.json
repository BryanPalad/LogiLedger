{
  "name": "logiledger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run cf:dev",
    "dev:vite": "vite",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cf:dev": "npm run build && wrangler pages dev dist --persist-to .wrangler/state --port 8790",
    "cf:db:create": "wrangler d1 create logiledger-db",
    "cf:db:migrate:local": "wrangler d1 migrations apply logiledger-db --local",
    "cf:db:migrate:remote": "wrangler d1 migrations apply logiledger-db --remote",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name logiledger"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@eslint/js": "latest",
    "@tailwindcss/vite": "^4.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "tailwindcss": "^4.3.2",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "wrangler": "4.86.0"
  }
}
